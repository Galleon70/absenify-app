{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/,_N_T_/index"},"segmentPaths":["/_tree","/_full","/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":160,"slots":null}}}},"html":"<!DOCTYPE html><html lang=\"id\" class=\"dark\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"/><link rel=\"preload\" as=\"image\" href=\"/hero1.jpg\"/><link rel=\"preload\" as=\"image\" href=\"/hero2.jpg\"/><link rel=\"preload\" as=\"image\" href=\"/hero3.jpg\"/><link rel=\"preload\" as=\"image\" href=\"/hero4.jpg\"/><link rel=\"preload\" as=\"image\" href=\"/hero5.jpg\"/><link rel=\"preload\" href=\"/tentang.jpg\" as=\"image\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/19i2rg6mqzm4_.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/0jvhpaew_uadu.js\"/><script src=\"/_next/static/chunks/0jw4jivscv1ye.js\" async=\"\"></script><script src=\"/_next/static/chunks/12_celfi3iros.js\" async=\"\"></script><script src=\"/_next/static/chunks/1mk2vwf00unkp.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0ei9r7inuw2i_.js\" async=\"\"></script><script src=\"/_next/static/chunks/32xp_xoymb5kg.js\" async=\"\"></script><script src=\"/_next/static/chunks/3n2ei0n973fqy.js\" async=\"\"></script><link rel=\"apple-touch-icon\" href=\"/icon-192.png\"/><meta name=\"theme-color\" content=\"#4f46e5\"/><title>NamaAplikasi: Aplikasi Absensi dan Izin Siswa Online untuk Sekolah</title><meta name=\"description\" content=\"Aplikasi absensi dan izin siswa online: guru mencatat kehadiran, orang tua mengajukan izin dengan bukti foto, kepala sekolah memantau ringkasan. Bisa dibuka dari HP, tanpa instal.\"/><link rel=\"manifest\" href=\"/manifest.json\"/><meta name=\"keywords\" content=\"aplikasi absensi sekolah,absensi siswa online,izin siswa online,absensi QR siswa,presensi sekolah digital\"/><meta name=\"robots\" content=\"index, follow\"/><link rel=\"canonical\" href=\"http://localhost:3000\"/><meta name=\"format-detection\" content=\"telephone=no\"/><meta name=\"mobile-web-app-capable\" content=\"yes\"/><meta name=\"apple-mobile-web-app-title\" content=\"HadirKu\"/><meta name=\"apple-mobile-web-app-status-bar-style\" content=\"default\"/><meta property=\"og:title\" content=\"NamaAplikasi: Absensi dan Izin Siswa Digital\"/><meta property=\"og:description\" content=\"Aplikasi absensi dan izin siswa online: guru mencatat kehadiran, orang tua mengajukan izin dengan bukti foto, kepala sekolah memantau ringkasan. Bisa dibuka dari HP, tanpa instal.\"/><meta property=\"og:site_name\" content=\"NamaAplikasi\"/><meta property=\"og:locale\" content=\"id_ID\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary\"/><meta name=\"twitter:title\" content=\"NamaAplikasi: Absensi dan Izin Siswa Digital\"/><meta name=\"twitter:description\" content=\"Aplikasi absensi dan izin siswa online: guru mencatat kehadiran, orang tua mengajukan izin dengan bukti foto, kepala sekolah memantau ringkasan. Bisa dibuka dari HP, tanpa instal.\"/><link rel=\"icon\" href=\"/icon-192.png\"/><link rel=\"apple-touch-icon\" href=\"/icon-192.png\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"antialiased bg-[#0b0f19] text-slate-100 min-h-screen m-0 p-0\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"min-h-screen bg-gradient-to-b from-indigo-50/70 via-white to-indigo-50/50 text-gray-900 font-sans antialiased\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"NamaAplikasi\",\"applicationCategory\":\"EducationalApplication\",\"operatingSystem\":\"Web\",\"description\":\"Aplikasi absensi dan izin siswa online: guru mencatat kehadiran, orang tua mengajukan izin dengan bukti foto, kepala sekolah memantau ringkasan. Bisa dibuka dari HP, tanpa instal.\",\"inLanguage\":\"id\"}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Apa itu NamaAplikasi?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Aplikasi absensi dan izin siswa yang bisa dibuka dari HP atau komputer, untuk guru, orang tua, kepala sekolah, dan admin sekolah.\"}},{\"@type\":\"Question\",\"name\":\"Apa bedanya Mode 1, 2, dan 3?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Mode 1 untuk guru, orang tua, admin, dan kepala sekolah. Mode 2 menambah akun murid untuk melihat rekap kehadirannya. Mode 3 menambah QR absensi di HP murid yang dipindai petugas.\"}},{\"@type\":\"Question\",\"name\":\"Apakah murid wajib membawa HP?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Tidak. Mode 1 dan 2 tidak membutuhkannya. Mode 3 untuk sekolah yang membolehkan murid membawa HP.\"}},{\"@type\":\"Question\",\"name\":\"Bagaimana kalau HP murid mati atau hilang?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Guru mengabsen murid secara manual di dashboard guru.\"}},{\"@type\":\"Question\",\"name\":\"Apakah data aman?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Password disimpan terenkripsi, percobaan login dibatasi, akses dibedakan per peran, dan data tiap sekolah dipisah.\"}},{\"@type\":\"Question\",\"name\":\"Bisakah sekolah lain melihat data kami?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Tidak. Data setiap sekolah terpisah dan hanya bisa dibuka oleh pengguna sekolah itu.\"}},{\"@type\":\"Question\",\"name\":\"Perlu memasang aplikasi?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Tidak. Cukup buka lewat browser, lalu boleh ditambahkan ke layar utama HP agar seperti aplikasi.\"}},{\"@type\":\"Question\",\"name\":\"Bagaimana kalau internet sekolah mati?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Pencatatan membutuhkan koneksi internet. Siapkan cadangan pencatatan manual sampai koneksi pulih.\"}},{\"@type\":\"Question\",\"name\":\"Berapa biayanya?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Biaya langganan per sekolah per bulan, tergantung mode. Hubungi kami untuk penawaran.\"}},{\"@type\":\"Question\",\"name\":\"Bisakah dicoba dulu?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Bisa. Minta demo lewat WhatsApp atau formulir di halaman ini.\"}},{\"@type\":\"Question\",\"name\":\"Berapa lama sampai bisa dipakai?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Setelah data kelas dan siswa diisi, sekolah bisa mulai memakai. Kami bantu proses awalnya.\"}},{\"@type\":\"Question\",\"name\":\"Kalau berhenti berlangganan, bagaimana datanya?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Akun sekolah dinonaktifkan dan data tidak dihapus otomatis. Kebijakan penyimpanan dan penghapusan data disepakati secara tertulis.\"}}]}</script><div class=\"fixed top-0 inset-x-0 z-30 pt-3 px-3 sm:px-4 pointer-events-none\"><header class=\"pointer-events-auto max-w-6xl mx-auto rounded-2xl bg-white/90 backdrop-blur shadow-sm border border-indigo-50\"><div class=\"px-4 sm:px-6 h-16 flex items-center justify-between gap-4\"><a href=\"/\" class=\"flex items-center gap-2 font-black text-lg text-indigo-800\"><span class=\"w-9 h-9 rounded-xl bg-indigo-700 text-white flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-school w-5 h-5\" aria-hidden=\"true\"><path d=\"M14 21v-3a2 2 0 0 0-4 0v3\"></path><path d=\"M18 4.933V21\"></path><path d=\"m4 6 7.106-3.79a2 2 0 0 1 1.788 0L20 6\"></path><path d=\"m6 11-3.52 2.147a1 1 0 0 0-.48.854V19a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-5a1 1 0 0 0-.48-.853L18 11\"></path><path d=\"M6 4.933V21\"></path><circle cx=\"12\" cy=\"9\" r=\"2\"></circle></svg></span>NamaAplika