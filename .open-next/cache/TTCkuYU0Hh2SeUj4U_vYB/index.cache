2.122 2.122 0 0 0 1.597-1.16z\"></path></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-4 h-4 fill-current\" aria-hidden=\"true\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-4 h-4 fill-current\" aria-hidden=\"true\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-4 h-4 fill-current\" aria-hidden=\"true\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-4 h-4 fill-current\" aria-hidden=\"true\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg></div><blockquote class=\"mt-3 text-sm text-gray-700\">“<!-- -->[Isi testimoni di sini.]<!-- -->”</blockquote><figcaption class=\"mt-4 text-sm\"><span class=\"font-bold\">[Nama]</span><span class=\"block text-xs text-gray-500\">[Jabatan, Nama Sekolah]</span></figcaption></figure></div></section><section id=\"tanya-jawab\" class=\"scroll-mt-28 max-w-3xl mx-auto px-3 sm:px-4 mt-20\"><h2 class=\"text-2xl sm:text-3xl font-black text-center\">Pertanyaan yang sering diajukan (FAQ)</h2><div class=\"mt-8 space-y-3\"><details class=\"group bg-white rounded-2xl border border-indigo-50 p-4\"><summary class=\"flex items-center justify-between gap-3 cursor-pointer font-bold text-sm list-none\">Apa itu NamaAplikasi?<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-gray-400 transition group-open:rotate-180 shrink-0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><p class=\"mt-2 text-sm text-gray-600\">Aplikasi absensi dan izin siswa yang bisa dibuka dari HP atau komputer, untuk guru, orang tua, kepala sekolah, dan admin sekolah.</p></details><details class=\"group bg-white rounded-2xl border border-indigo-50 p-4\"><summary class=\"flex items-center justify-between gap-3 cursor-pointer font-bold text-sm list-none\">Apa bedanya Mode 1, 2, dan 3?<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-gray-400 transition group-open:rotate-180 shrink-0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><p class=\"mt-2 text-sm text-gray-600\">Mode 1 untuk guru, orang tua, admin, dan kepala sekolah. Mode 2 menambah akun murid untuk melihat rekap kehadirannya. Mode 3 menambah QR absensi di HP murid yang dipindai petugas.</p></details><details class=\"group bg-white rounded-2xl border border-indigo-50 p-4\"><summary class=\"flex items-center justify-between gap-3 cursor-pointer font-bold text-sm list-none\">Apakah murid wajib membawa HP?<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-gray-400 transition group-open:rotate-180 shrink-0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><p class=\"mt-2 text-sm text-gray-600\">Tidak. Mode 1 dan 2 tidak membutuhkannya. Mode 3 untuk sekolah yang membolehkan murid membawa HP.</p></details><details class=\"group bg-white rounded-2xl border border-indigo-50 p-4\"><summary class=\"flex items-center justify-between gap-3 cursor-pointer font-bold text-sm list-none\">Bagaimana kalau HP murid mati atau hilang?<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-gray-400 transition group-open:rotate-180 shrink-0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><p class=\"mt-2 text-sm text-gray-600\">Guru mengabsen murid secara manual di dashboard guru.</p></details><details class=\"group bg-white rounded-2xl border border-indigo-50 p-4\"><summary class=\"flex items-center justify-between gap-3 cursor-pointer font-bold text-sm list-none\">Apakah data aman?<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-gray-400 transition group-open:rotate-180 shrink-0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><p class=\"mt-2 text-sm text-gray-600\">Password disimpan terenkripsi, percobaan login dibatasi, akses dibedakan per peran, dan data tiap sekolah dipisah.</p></details><details class=\"group bg-white rounded-2xl border border-indigo-50 p-4\"><summary class=\"flex items-center justify-between gap-3 cursor-pointer font-bold text-sm list-none\">Bisakah sekolah lain melihat data kami?<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-gray-400 transition group-open:rotate-180 shrink-0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><p class=\"mt-2 text-sm text-gray-600\">Tidak. Data setiap sekolah terpisah dan hanya bisa dibuka oleh pengguna sekolah itu.</p></details><details class=\"group bg-white rounded-2xl border border-indigo-50 p-4\"><summary class=\"flex items-center justify-between gap-3 cursor-pointer font-bold text-sm list-none\">Perlu memasang aplikasi?<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-gray-400 transition group-open:rotate-180 shrink-0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><p class=\"mt-2 text-sm text-gray-600\">Tidak. Cukup buka lewat browser, lalu boleh ditambahkan ke layar utama HP agar seperti aplikasi.</p></details><details class=\"group bg-white rounded-2xl border border-indigo-50 p-4\"><summary class=\"flex items-center justify-between gap-3 cursor-pointer font-bold text-sm list-none\">Bagaimana kalau internet sekolah mati?<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-gray-400 transition group-open:rotate-180 shrink-0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><p class=\"mt-2 text-sm text-gray-600\">Pencatatan membutuhkan koneksi internet. Siapkan cadangan pencatatan manual sampai koneksi pulih.</p></details><details class=\"group bg-white rounded-2xl border border-indigo-50 p-4\"><summary class=\"flex items-center justify-between gap-3 cursor-pointer font-bold text-sm list-none\">Berapa biayanya?<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-gray-400 transition group-open:rotate-180 shrink-0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><p class=\"mt-2 text-sm text-gray-600\">Biaya langganan per sekolah per bulan, tergantung mode. Hubungi kami untuk penawaran.</p></details><details class=\"group bg-white rounded-2xl border border-indigo-50 p-4\"><summary class=\"flex items-center justify-between gap-3 cursor-pointer font-bold text-sm list-none\">Bisakah dicoba dulu?<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-gray-400 transition group-open:rotate-180 shrink-0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><p class=\"mt-2 text-sm text-gray-600\">Bisa. Minta demo lewat WhatsApp atau formulir di halaman ini.</p></details><details class=\"group bg-white rounded-2xl border border-indigo-50 p-4\"><summary class=\"flex items-center justify-between gap-3 cursor-pointer font-bold text-sm list-none\">Berapa lama sampai bisa dipakai?<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-gray-400 transition group-open:rotate-180 shrink-0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><p class=\"mt-2 text-sm text-gray-600\">Setelah data kelas dan siswa diisi, sekolah bisa mulai memakai. Kami bantu proses awalnya.</p></details><details class=\"group bg-white rounded-2xl border border-indigo-50 p-4\"><summary class=\"flex items-center justify-between gap-3 cursor-pointer font-bold text-sm list-none\">Kalau berhenti berlangganan, bagaimana datanya?<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-gray-400 transition group-open:rotate-180 shrink-0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><p class=\"mt-2 text-sm text-gray-600\">Akun sekolah dinonaktifkan dan data tidak dihapus otomatis. Kebijakan penyimpanan dan penghapusan data disepakati secara tertulis.</p></details></div></section><section id=\"demo\" class=\"scroll-mt-28 max-w-6xl mx-auto px-3 sm:px-4 mt-20 mb-16\"><div class=\"rounded-3xl bg-gradient-to-r from-indigo-900 to-indigo-600 text-white p-8 sm:p-10 flex flex-col md:flex-row items-center justify-between gap-6\"><div class=\"flex items-center gap-4\"><span class=\"w-14 h-14 rounded-2xl bg-white/15 flex items-center justify-center shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-school w-7 h-7\" aria-hidden=\"true\"><path d=\"M14 21v-3a2 2 0 0 0-4 0v3\"></path><path d=\"M18 4.933V21\"></path><path d=\"m4 6 7.106-3.79a2 2 0 0 1 1.788 0L20 6\"></path><path d=\"m6 11-3.52 2.147a1 1 0 0 0-.48.854V19a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-5a1 1 0 0 0-.48-.853L18 11\"></path><path d=\"M6 4.933V21\"></path><circle cx=\"12\" cy=\"9\" r=\"2\"></circle></svg></span><div><h2 class=\"text-xl sm:text-2xl font-black\">Siap mencoba untuk sekolah Anda?</h2><p class=\"mt-1 text-sm text-indigo-100\">Isi data singkat di bawah, lalu kirim lewat WhatsApp. Kami akan menghubungi Anda.</p></div></div><a href=\"https://wa.me/6281234567890?text=Halo%2C%20saya%20ingin%20tanya%20demo%20aplikasi%20absensi%20sekolah.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"min-h-12 px-6 rounded-xl bg-white text-indigo-800 font-bold text-sm flex items-center justify-center gap-2 shrink-0 hover:bg-indigo-50\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-message-circle w-4 h-4\" aria-hidden=\"true\"><path d=\"M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719\"></path></svg> Chat WhatsApp</a></div><div class=\"mt-6 max-w-2xl mx-auto bg-white rounded-3xl border border-indigo-50 shadow-sm p-6\"><form class=\"space-y-3 text-left\"><div class=\"grid sm:grid-cols-2 gap-3\"><input required=\"\" placeholder=\"Nama sekolah\" class=\"w-full bg-white text-gray-900 border border-gray-200 rounded-xl p-3 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\" value=\"\"/><select class=\"w-full bg-white text-gray-900 border border-gray-200 rounded-xl p-3 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\" aria-label=\"Jenjang\"><option>SD / MI</option><option>SMP / MTs</option><option>SMA / MA</option><option>SMK</option><option>Lainnya</option></select><input required=\"\" placeholder=\"Kota / kabupaten\" class=\"w-full bg-white text-gray-900 border border-gray-200 rounded-xl p-3 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\" value=\"\"/><input type=\"number\" min=\"1\" placeholder=\"Perkiraan jumlah murid\" class=\"w-full bg-white text-gray-900 border border-gray-200 rounded-xl p-3 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\" value=\"\"/><select class=\"w-full bg-white text-gray-900 border border-gray-200 rounded-xl p-3 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\" aria-label=\"Murid boleh bawa HP\"><option value=\"Ya\" selected=\"\">Murid boleh membawa HP</option><option value=\"Tidak\">Murid tidak boleh membawa HP</option><option value=\"Sebagian\">Sebagian boleh</option></select><input required=\"\" placeholder=\"Nama Anda\" class=\"w-full bg-white text-gray-900 border border-gray-200 rounded-xl p-3 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none\" value=\"\"/></div><button type=\"submit\" class=\"w-full min-h-12 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl flex items-center justify-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-message-circle w-5 h-5\" aria-hidden=\"true\"><path d=\"M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719\"></path></svg> Kirim lewat WhatsApp</button><p class=\"text-xs text-gray-500 text-center\">Pesan dibuka di WhatsApp dan baru terkirim setelah Anda menekan kirim.</p></form></div></section></main><footer class=\"border-t border-indigo-100 bg-white/70\"><div class=\"max-w-6xl mx-auto px-4 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-600\"><p>© <!-- -->2026<!-- --> <!-- -->NamaAplikasi<!-- -->. <!-- -->Absensi dan izin siswa digital untuk sekolah di seluruh Indonesia<!-- -->.</p><div class=\"flex items-center gap-4\"><a href=\"https://wa.me/6281234567890?text=Halo%2C%20saya%20ingin%20tanya%20demo%20aplikasi%20absensi%20sekolah.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"flex items-center gap-1.5 font-semibold hover:text-indigo-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-message-circle w-4 h-4\" aria-hidden=\"true\"><path d=\"M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719\"></path></svg>WhatsApp</a><a href=\"mailto:nama@gmail.com?subject=Tanya%20Demo\" class=\"flex items-center gap-1.5 font-semibold hover:text-indigo-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail w-4 h-4\" aria-hidden=\"true\"><path d=\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\"></path><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"></rect></svg>Email</a><a href=\"/login\" class=\"font-semibold hover:text-indigo-700\">Masuk ke aplikasi</a></div></div></