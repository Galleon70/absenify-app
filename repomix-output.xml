// src/app/parent/dashboard/page.tsx
"use client";

import React, { useCallback, useEffect, useState } from "react";
import Header from "@/components/Header";
import ParentDashboard, {
  type Child,
  type ParentLeave,
  type ParentAttendance,
} from "@/components/parent/ParentDashboard";
import type { NotificationItem } from "@/types";

const READ_KEY = "hadirku:parent-notif-read";

const fmtDate = (d: string) => {
  const [y, m, day] = d.split("-");
  const bulan = ["Jan", "Feb", "Mar", "Apr", "Mei", "Jun", "Jul", "Agu", "Sep", "Okt", "Nov", "Des"];
  return `${Number(day)} ${bulan[Number(m) - 1] ?? m} ${y}`;
};

function loadReadIds(): string[] {
  try {
    const raw = localStorage.getItem(READ_KEY);
    return raw ? (JSON.parse(raw) as string[]) : [];
  } catch {
    return [];
  }
}

function saveReadIds(ids: string[]) {
  try {
    localStorage.setItem(READ_KEY, JSON.stringify(ids));
  } catch {
    /* abaikan: penyimpanan browser tidak tersedia */
  }
}

export default function ParentDashboardPage() {
  const [children, setChildren] = useState<Child[]>([]);
  const [leaves, setLeaves] = useState<ParentLeave[]>([]);
  const [attendance, setAttendance] = useState<ParentAttendance[]>([]);
  const [loading, setLoading] = useState(true);
  const [readIds, setReadIds] = useState<string[]>([]);

  useEffect(() => {
    setReadIds(loadReadIds());
  }, []);

  const loadData = useCallback(async () => {
    try {
      const [rc, rl, ra] = await Promise.all([
        fetch("/api/parent/children"),
        fetch("/api/leave"),
        fetch("/api/attendance"),
      ]);
      if (rc.ok) setChildren((await rc.json()).data ?? []);
      if (rl.ok) setLeaves((await rl.json()).data ?? []);
      if (ra.ok) setAttendance((await ra.json()).data ?? []);
    } catch (err) {
      console.error("Gagal memuat data orang tua:", err);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    loadData();
  }, [loadData]);

  // Notifikasi orang tua = hasil keputusan izin anaknya (disetujui / ditolak)
  const notifications: NotificationItem[] = leaves
    .filter((l) => l.status === "APPROVED" || l.status === "REJECTED")
    .map((l) => {
      const id = `leave-${l.id}-${l.status}`;
      const jenis = l.type === "SAKIT" ? "Izin sakit" : "Izin";
      const approved = l.status === "APPROVED";
      return {
        id,
        title: approved ? "Pengajuan Izin Disetujui" : "Pengajuan Izin Ditolak",
        message: `${jenis} ${l.student.name} (${fmtDate(l.startDate)}${
          l.startDate !== l.endDate ? ` s/d ${fmtDate(l.endDate)}` : ""
        }) ${approved ? "telah disetujui." : "ditolak. Hubungi wali kelas jika ada pertanyaan."}`,
        timestamp: l.createdAt,
        read: readIds.includes(id),
        type: "LEAVE" as const,
        targetRoles: ["PARENT" as const],
      };
    });

  const markRead = (id: string) => {
    setReadIds((prev) => {
      if (prev.includes(id)) return prev;
      const next = [...prev, id];
      saveReadIds(next);
      return next;
    });
  };
  const markAllRead = () => {
    const next = Array.from(new Set([...readIds, ...notifications.map((n) => n.id)]));
    setReadIds(next);
    saveReadIds(next);
  };

  return (
    <div className="min-h-screen bg-slate-50 text-gray-900 font-sans antialiased">
      <Header
        currentRole="PARENT"
        notifications={notifications}
        onMarkNotificationRead={markRead}
        onMarkAllNotificationsRead={markAllRead}
      />
      <main className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <ParentDashboard
          loading={loading}
          students={children}
          leaves={leaves}
          attendance={attendance}
          onLeaveSubmitted={loadData}
        />
      </main>
    </div>
  );
}
</file>

